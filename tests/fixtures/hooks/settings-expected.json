{
  // permissions of the team
  "permissions": {
    "deny": [
      "Read(./node_modules/**)" // generated
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "echo user-hook", "timeout": 5 }]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/harness/hooks/hook.py\"; [ -f \"$f\" ] || exit 0; t=; command -v timeout >/dev/null 2>&1 && t=\"timeout 3\"; p=; for c in python python3 py; do a=; [ \"$c\" = py ] && a=-3; $t \"$c\" $a -c \"import sys; sys.exit(sys.version_info < (3, 9))\" >/dev/null 2>&1 && { p=$c; break; }; done; [ -n \"$p\" ] || exit 0; \"$p\" $a \"$f\" pre-edit; rc=$?; [ \"$rc\" -eq 2 ] && exit 2; exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/harness/hooks/hook.py\"; [ -f \"$f\" ] || exit 0; t=; command -v timeout >/dev/null 2>&1 && t=\"timeout 3\"; p=; for c in python python3 py; do a=; [ \"$c\" = py ] && a=-3; $t \"$c\" $a -c \"import sys; sys.exit(sys.version_info < (3, 9))\" >/dev/null 2>&1 && { p=$c; break; }; done; [ -n \"$p\" ] || exit 0; \"$p\" $a \"$f\" pre-bash; rc=$?; [ \"$rc\" -eq 2 ] && exit 2; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/harness/hooks/hook.py\"; [ -f \"$f\" ] || exit 0; t=; command -v timeout >/dev/null 2>&1 && t=\"timeout 3\"; p=; for c in python python3 py; do a=; [ \"$c\" = py ] && a=-3; $t \"$c\" $a -c \"import sys; sys.exit(sys.version_info < (3, 9))\" >/dev/null 2>&1 && { p=$c; break; }; done; [ -n \"$p\" ] || exit 0; \"$p\" $a \"$f\" post-edit; rc=$?; [ \"$rc\" -eq 2 ] && exit 2; exit 0",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
