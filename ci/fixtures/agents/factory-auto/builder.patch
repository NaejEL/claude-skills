diff --git a/toy/core.py b/toy/core.py
--- a/toy/core.py
+++ b/toy/core.py
@@ -7,3 +7,8 @@ def total(values):
     for value in values:
         result += value
     return result
+
+
+def mean(values):
+    """Return the average of the values (0 for an empty list)."""
+    return total(values) / len(values) if values else 0
